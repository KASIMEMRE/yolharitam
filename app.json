{
  "expo": {
    "name": "Yol Haritam",
    "slug": "yolharitam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yolharitam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kasimemre.yolharitam",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1B1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kasimemre.yolharitam",
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1B1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kasimemre",
    "extra": {
      "eas": {
        "projectId": "e03fade5-4f9b-4b83-96a5-c76b292b1c08"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e03fade5-4f9b-4b83-96a5-c76b292b1c08"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
